# Configuration de l'application
PORT=3000

# Configuration PostgreSQL (OBLIGATOIRE - pas de valeurs par défaut)
# ⚠️ IMPORTANT : Changez ces valeurs par des secrets sécurisés !
POSTGRES_USER=ocoffee
POSTGRES_PASSWORD=changez_moi_par_un_mot_de_passe_securise
POSTGRES_DB=ocoffee
POSTGRES_PORT=5432

# Configuration Adminer (optionnel, uniquement pour docker-compose.local.yml)
ADMINER_PORT=8080

# URL de connexion PostgreSQL (générée automatiquement)
# PG_URL sera construit automatiquement à partir des variables ci-dessus
