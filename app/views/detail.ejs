<%- include ('partials/header'); %>
<main class="flex-1 bg-ocoffee-bg py-12">
    <section class="page-shell grid max-w-5xl gap-10 md:grid-cols-[1fr_1.1fr]" data-aos="fade-up">
        <div class="overflow-hidden rounded-lg" data-aos="fade-right">
            <img class="aspect-square w-full object-cover" src="/static/00.assets/coffees/<%= coffee.reference %>.webp" alt="<%= coffee.name %>">
        </div>
        <div class="flex flex-col gap-6" data-aos="fade-left">
            <h1 class="font-display text-3xl font-semibold text-ocoffee-amber sm:text-4xl"><%= coffee.name %></h1>
            <dl class="flex flex-col gap-4 text-base">
                <div>
                    <dt class="text-sm font-semibold uppercase tracking-wider text-ocoffee-amber">Description</dt>
                    <dd class="mt-1 text-ocoffee-text-muted"><%= coffee.description %></dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold uppercase tracking-wider text-ocoffee-amber">Origine</dt>
                    <dd class="mt-1 text-ocoffee-text-muted"><%= coffee.origin %></dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold uppercase tracking-wider text-ocoffee-amber">Prix au kilo</dt>
                    <dd class="mt-1 text-ocoffee-text-muted"><%= coffee.price %> €</dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold uppercase tracking-wider text-ocoffee-amber">Caractéristique principale</dt>
                    <dd class="mt-1 text-ocoffee-text-muted"><%= coffee.category %></dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold uppercase tracking-wider text-ocoffee-amber">Disponible</dt>
                    <dd class="mt-1">
                        <% if (coffee.available===true) { %>
                        <span class="font-semibold text-ocoffee-success">Oui</span>
                        <% } else { %>
                        <span class="font-semibold text-ocoffee-error">Non</span>
                        <% } %>
                    </dd>
                </div>
            </dl>
        </div>
    </section>
</main>
<%- include ('partials/footer'); %>
