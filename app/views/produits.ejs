<%- include ('partials/header'); %>
<main class="flex-1 bg-ocoffee-bg pb-16">
    <div class="page-shell py-10">
        <h1 class="section-title mb-10" data-aos="fade-up">Notre catalogue</h1>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
            <aside class="w-full shrink-0 rounded-lg border border-neutral-200 bg-neutral-50 p-5 lg:sticky lg:top-24 lg:w-60" data-aos="fade-right">
                <h2 class="font-display text-lg font-semibold text-ocoffee-title">Catégories</h2>
                <p class="mt-2 text-sm text-ocoffee-text-muted">
                    Filtrer par catégorie ou afficher tout le catalogue.
                </p>
                <form class="mt-5" action="/produits" method="GET">
                    <fieldset class="border-0 p-0">
                        <legend class="sr-only">Choisir une catégorie</legend>
                        <div class="flex flex-col gap-1">
                            <% allCategories.forEach(category=> { %>
                            <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm hover:bg-ocoffee-dropdown-hover">
                                <input type="radio" name="category" value="<%= category.category %>" class="h-3.5 w-3.5 border-ocoffee-brown text-ocoffee-amber focus:ring-ocoffee-amber">
                                <span><%= category.category %></span>
                            </label>
                            <% }) %>
                        </div>
                    </fieldset>
                    <div class="mt-4 flex flex-col gap-2">
                        <button type="submit" class="btn-primary w-full justify-center text-sm">
                            <span>Valider</span>
                            <i data-lucide="check" class="h-3.5 w-3.5"></i>
                        </button>
                        <a href="/produits" class="btn-primary w-full justify-center text-sm">
                            <span>Voir tous</span>
                            <i data-lucide="layout-grid" class="h-3.5 w-3.5"></i>
                        </a>
                    </div>
                </form>
            </aside>
            <section class="min-w-0 flex-1">
                <div class="mb-6 flex justify-end">
                    <button id="voir-tous-btn" class="btn-primary text-sm" type="button">
                        <span>Tous voir</span>
                        <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
                    </button>
                </div>
                <div id="catalog-preview" class="container_produits product-grid">
                    <% coffees3.forEach((coffee, index)=> { %>
                    <article class="product-card" data-aos="fade-up" data-aos-delay="<%= index * 80 %>">
                        <img class="product-card-image" src="/static/00.assets/coffees/<%= coffee.reference %>.webp" alt="<%= coffee.name %>">
                        <div class="flex flex-1 flex-col gap-3 p-5 text-left">
                            <h2 class="font-display text-xl font-semibold text-ocoffee-amber"><%= coffee.name %></h2>
                            <p class="line-clamp-2 text-sm leading-relaxed text-ocoffee-text-muted"><%= coffee.description %></p>
                            <div class="mt-auto flex items-center justify-between pt-2">
                                <span class="font-bold text-ocoffee-price"><%= coffee.price %> €</span>
                                <a href="/produit/<%= coffee.id %>" class="btn-primary text-sm">
                                    <span>Découvrir</span>
                                    <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                    <% }) %>
                </div>
                <div id="catalog-full" class="container_produits-full product-grid hidden">
                    <% allCoffees.forEach((coffee, index)=> { %>
                    <article class="product-card" data-aos="fade-up" data-aos-delay="<%= index * 80 %>">
                        <img class="product-card-image" src="/static/00.assets/coffees/<%= coffee.reference %>.webp" alt="<%= coffee.name %>">
                        <div class="flex flex-1 flex-col gap-3 p-5 text-left">
                            <h2 class="font-display text-xl font-semibold text-ocoffee-amber"><%= coffee.name %></h2>
                            <p class="line-clamp-2 text-sm leading-relaxed text-ocoffee-text-muted"><%= coffee.description %></p>
                            <div class="mt-auto flex items-center justify-between pt-2">
                                <span class="font-bold text-ocoffee-price"><%= coffee.price %> €</span>
                                <a href="/produit/<%= coffee.id %>" class="btn-primary text-sm">
                                    <span>Découvrir</span>
                                    <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                    <% }) %>
                </div>
            </section>
        </div>
    </div>
</main>
<%- include ('partials/footer'); %>
